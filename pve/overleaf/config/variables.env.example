OVERLEAF_APP_NAME="Overleaf"
OVERLEAF_SITE_URL=https://overleaf.tail91459b.ts.net
OVERLEAF_ADMIN_EMAIL=you@example.com
OVERLEAF_SECURE_COOKIE=true
EMAIL_CONFIRMATION_DISABLED=true
ENABLED_LINKED_FILE_TYPES=project_file,project_output_file

# Anonymous link sharing is DISABLED (default). Enabling it
# (OVERLEAF_ALLOW_PUBLIC_ACCESS=true + OVERLEAF_ALLOW_ANONYMOUS_READ_AND_WRITE_SHARING=true)
# lets anyone with a project link edit without an account, BUT Overleaf CE 6.3.0
# has a bug: anonymous edits stamp lastUpdatedBy="anonymous-user", which the web
# doc schema rejects (not a Mongo ObjectId) -> the doc never flushes -> every
# compile fails with "files out of sync". Use named accounts instead.
OVERLEAF_ALLOW_PUBLIC_ACCESS=false
OVERLEAF_ALLOW_ANONYMOUS_READ_AND_WRITE_SHARING=false

# Compile guards for a 2-vCPU host
COMPILE_TIMEOUT=120
COMPILE_SIZE_LIMIT=7000000
