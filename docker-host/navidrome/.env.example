# Navidrome — copy to .env and edit.
# The music folder and data folder are set in compose.yaml (ND_MUSICFOLDER,
# ND_DATAFOLDER); only tweak the rest here.
# NB: v0.55.0 renamed ScanSchedule -> Scanner.Schedule, so the env var is now
# ND_SCANNER_SCHEDULE. The old ND_SCANSCHEDULE is silently ignored and scanning
# stays disabled.
ND_SCANNER_SCHEDULE=@every 1h
ND_LOGLEVEL=info
# ND_BASEURL=
# ND_LASTFM_APIKEY=
# ND_LASTFM_SECRET=
