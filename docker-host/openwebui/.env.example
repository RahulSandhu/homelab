# Copy to .env (git-ignored) and fill in. Never commit real values.

# Tailscale auth key for the "chat" node.
# Admin console -> Settings -> Keys: Reusable ON, Ephemeral OFF, no tags.
# A reusable key already used by another stack works.
TS_AUTHKEY=

# Open WebUI session secret. Generate with:
#   openssl rand -hex 32
WEBUI_SECRET_KEY=
