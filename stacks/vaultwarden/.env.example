# ---------------------------------------------------------------------------
# Vaultwarden configuration — example file.
#
#   cp .env.example .env      # then edit .env
#
# .env is git-ignored. NEVER commit it, and never paste a real ADMIN_TOKEN
# or DOMAIN into this example file.
# ---------------------------------------------------------------------------

# Public URL clients will use. Must be the HTTPS name your tailnet exposes,
# and it must match EXACTLY what `tailscale serve` publishes.
# In this deployment: https://pve.tail91459b.ts.net
DOMAIN=https://pve.tail91459b.ts.net

# Port Vaultwarden listens on inside the container. Leave at 80.
ROCKET_PORT=80

# Container timezone (affects logs and the admin panel).
TZ=Europe/Madrid

# --- First run -------------------------------------------------------------
# Signups must be OPEN to create your very first account, because there is no
# other way in. THE MOMENT YOUR ACCOUNT EXISTS, set this to false and restart:
#     sed -i 's/^SIGNUPS_ALLOWED=true/SIGNUPS_ALLOWED=false/' .env
#     docker compose up -d
SIGNUPS_ALLOWED=true

# --- Admin panel -----------------------------------------------------------
# Token for /admin. Store ONLY as an Argon2 hash, never in plaintext.
#
# Generate it — this NEEDS a real terminal. Without a TTY the command panics
# with "No such device or address":
#     docker run --rm -it vaultwarden/server:1.37.3 /vaultwarden hash
#
# GOTCHA: Docker Compose interpolates `$` inside .env, so the hash's dollar
# signs must be escaped as `$$`. An unescaped `$argon2id$v=19$...` gets mangled
# and Vaultwarden silently falls back to a plain-text token (with a warning in
# the logs). Store it like:
#     ADMIN_TOKEN=$$argon2id$$v=19$$m=65540,t=3,p=4$$<salt>$$<hash>
ADMIN_TOKEN=

# --- Hardening -------------------------------------------------------------
INVITATIONS_ALLOWED=true
LOG_LEVEL=warn
# WEB_VAULT_ENABLED=true
