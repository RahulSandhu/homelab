# Copy to .env (git-ignored) and fill in. Never commit real values.

# Required — signs cookies/sessions. Changing it logs everyone out.
# Generate:  openssl rand -base64 42 | tr -dc A-Za-z0-9 | cut -c -32
CORE_SECRET=

# Required — PostgreSQL password (generate the same way).
POSTGRESQL_PASSWORD=
POSTGRESQL_USER=zipline
POSTGRESQL_DB=zipline

# Tailscale auth key for the "zipline" node.
# Admin console -> Settings -> Keys: Reusable ON, Ephemeral OFF, no tags.
TS_AUTHKEY=
